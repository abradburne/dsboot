#!/bin/sh
# dsboot: replaces /etc/init.d/rcS. The stock rcS is kept in /etc/dsboot/stock and is what
# runs whenever the fast order is switched off or the last fast boot did not reach the menu.
#
# The stock order starts every service one after another and only then the screen and the
# menu. This one runs the same scripts, but brings up the screen, sound and the menu first
# and leaves the rest (SSH, time sync, mDNS, cron...) until the menu is already loading.

state=/etc/dsboot
d=/etc/init.d
# Seconds since the kernel started its clock, beside each step, for dsboot_timing to collect.
log=/tmp/dsboot.log

note() {
	read -r t _ < /proc/uptime
	echo "$t $*" >> "$log"
}

# How busy the processor has been and how much has been read from the cards so far: whether
# a stretch of the start was spent computing or waiting for the card.
load() {
	read -r _ user _ system idle iowait _ < /proc/stat
	note "$1: cpu ticks user $user system $system idle $idle waiting $iowait;$(awk '$3 ~ /^mmcblk[0-9]$/ { printf " %s %d MB in %d ms;", $3, $6 / 2048, $7 }' /proc/diskstats)"
}

stock() {
	[ -x "$state/stock/rcS" ] && exec "$state/stock/rcS"
	# The kept copy is gone. Do what it does: every script, in order.
	for i in "$d"/S??*; do
		run "$i"
	done
	exit
}

# As the stock rcS runs them.
run() {
	f=$1
	[ -f "$f" ] || return
	case "$f" in
		*.sh)
			(
				trap - INT QUIT TSTP
				set start
				. "$f"
			)
			;;
		*)
			"$f" start
			;;
	esac
	note "done ${f##*/}"
}

[ -f "$state/enabled" ] || stock

# "booting" is put down here and taken away once the menu (or the card's update hook) is
# running. Finding it still there means the last fast boot never got that far: go back to
# the stock order and stay there until dsboot_install is run again.
if [ -f "$state/booting" ]; then
	rm -f "$state/booting" "$state/enabled"
	echo "fast boot did not reach the menu; stock order restored" > "$state/last"
	# init has already mounted from the changed fstab. Put the stock one back and mount again,
	# in case the change is what went wrong.
	if [ -f "$state/stock/fstab" ]; then
		cp "$state/stock/fstab" /etc/fstab && mount -a
	fi
	stock
fi
: > "$state/booting" || stock
load "rcS started, fast order"
# Two things are set going here and carry on beside the scripts below.
#
# Compressed copies of the libraries a start reads the most of are mounted over the
# originals: less comes off the card, and the processors, which mostly wait for it, do the
# unpacking. A file is only covered while the original has the size and date it had at install.
#
# Then, reading ahead: the card is the slow part of starting, and sits half idle while udev
# works. On the first start after an install nothing is read ahead; instead, what has been
# read from the card is written down at three moments (see learn below). Every start after
# that reads those three lists back in, in order.
under="/usr /etc /mnt/vendor/bin /mnt/vendor/ctrl /mnt/vendor/sbin /mnt/vendor/resource /mnt/mmc/Roms/APPS /mnt/mmc/update"
covered=/run/dsboot-hot.done
learning=
if [ -x "$state/readahead" ]; then
	if [ -f "$state/learn" ]; then
		rm -f "$state/learn" "$state/readahead.1" "$state/readahead.2" "$state/readahead.3"
		learning=1
	fi
	(
		if [ -f "$state/hot.sqsh" ] && [ -f "$state/hot.list" ]; then
			mkdir -p /run/dsboot-hot
			mount -t squashfs -o loop,ro "$state/hot.sqsh" /run/dsboot-hot &&
				"$state/readahead" cover /run/dsboot-hot "$state/hot.list"
			note "compressed copies mounted"
		fi
		: > "$covered"
		if [ -z "$learning" ] && [ -f "$state/readahead.1" ]; then
			"$state/readahead" play "$state/readahead.1" "$state/readahead.2" "$state/readahead.3"
			note "read ahead finished"
		fi
	) &
else
	: > "$covered"
fi

# learn N [NAME...]: on a learning start, list what is in memory now, the files of the
# programs called NAME first.
learn() {
	[ -n "$learning" ] || return
	list="$state/readahead.$1"
	shift
	note "$("$state/readahead" record "$list" --first "$@" --under $under 2>&1)"
}
# With /etc/dsboot/trace there, more is written down: see the launch below, and Weston
# reports how long the dynamic loader took to start it.
trace=
if [ -f "$state/trace" ] && [ -f "$state/trace.sh" ]; then
	trace=1
	read -r scheduler < /sys/block/mmcblk1/queue/scheduler
	note "card scheduler: $scheduler"
fi

first="S00mountall.sh S01log-guardian.sh S01seedrng S01syslogd S02klogd S02sysctl S05async-commit.sh S10udev S30dbus S49weston"
# The vendor launch script switches Wi-Fi and Bluetooth off through these, so they have to
# be up before it runs. They start beside PulseAudio instead of ahead of it.
radio="S36wifibt-init.sh S40bluetoothd S45network-manager"

for s in $first; do
	if [ $s = S49weston ]; then
		# Nothing before this uses the covered libraries; Weston is the first that does.
		n=0
		while [ ! -e "$covered" ] && [ $n -lt 100 ]; do
			sleep 0.02
			n=$((n + 1))
		done
		load "before the screen"
		learn 1 udevd dbus-daemon
		[ -z "$trace" ] || export LD_DEBUG=statistics
	fi
	run "$d/$s"
	unset LD_DEBUG
done
# An app on the OS card can ask to be started as soon as the screen is up, without waiting
# for the vendor launch script: update/early.sh, beside the update.sh that script runs. With
# one there, the radios can wait until it is on its way. The card is not mounted yet, so this
# goes by what the last start found. The launch script then has to wait for the radios before
# it switches them off (see radios-wait), which is only worth it when it is not what brings
# up the first thing on screen.
early=/mnt/mmc/update/early.sh
later=
if [ -f "$state/early" ] && [ -x "$state/radios-wait" ]; then
	later=1
	: > /run/dsboot-radios.later
else
	(
		for s in $radio; do
			run "$d/$s"
		done
	) &
	radio_pid=$!
fi
run "$d/S50pulseaudio"
[ -n "$later" ] || wait $radio_pid
load "sound up${later:+, radios to come}"
# The vendor launch script looks for Weston's socket every half second. Waiting for it here,
# in small steps, means it is found at the first look.
n=0
while [ ! -S /var/run/wayland-0 ] && [ $n -lt 60 ]; do
	sleep 0.05
	n=$((n + 1))
done
load "screen up"
learn 2 weston pulseaudio NetworkManager bluetoothd
# When tracing, the launch script and autostart log each command they run.
[ -z "$trace" ] || export BASH_ENV="$state/trace.sh"
run "$d/S60launch"
unset BASH_ENV
if [ -f "$early" ]; then
	# The app may say when its first picture is up, by creating this file.
	DSBOOT_SHOWN=/run/dsboot-early.shown bash "$early" > /dev/null 2>&1 &
	note "early app started"
	[ -f "$state/early" ] || : > "$state/early"
elif [ -f "$state/early" ]; then
	rm -f "$state/early"
fi
if [ -n "$later" ]; then
	# Starting the radios takes the card for a second or more. Wait until the early app has
	# its first picture up, or five seconds.
	n=0
	while [ -f "$early" ] && [ ! -e /run/dsboot-early.shown ] && [ $n -lt 100 ]; do
		sleep 0.05
		n=$((n + 1))
	done
	note "early app's first picture up"
	for s in $radio; do
		run "$d/$s"
	done
	: > /run/dsboot-radios.up
	load "radios up"
fi

(
	n=0
	while [ $n -lt 90 ]; do
		if [ -S /var/run/wayland-0 ] && pgrep -f 'dmenu_ln|update/update\.sh' > /dev/null; then
			rm -f "$state/booting"
			echo "fast boot reached the menu at $(cut -d' ' -f1 /proc/uptime) s" > "$state/last"
			# Give the menu, or what the card's hook starts, time to come up.
			if [ -n "$learning" ]; then
				sleep 6
				learn 3 weston
			fi
			break
		fi
		sleep 1
		n=$((n + 1))
	done
	# A way out from a computer: a file called dsboot.off on the ROMS volume.
	if [ -f /mnt/mmc/dsboot.off ]; then
		rm -f "$state/enabled"
	fi
) &

for i in "$d"/S??*; do
	case " $first $radio S50pulseaudio S60launch " in
		*" ${i##*/} "*) continue ;;
	esac
	run "$i"
done
load "all started"
